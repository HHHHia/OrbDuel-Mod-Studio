cmake_minimum_required(VERSION 3.20)
# 从已提交源码生成独立交接仓库；不复制原 .git、私人配置、存档或构建目录。
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED OUTPUT)
  set(OUTPUT "${root}/dist/OrbDuel-source-share")
endif()
get_filename_component(OUTPUT "${OUTPUT}" ABSOLUTE)
if(EXISTS "${OUTPUT}")
  message(FATAL_ERROR "Output already exists; choose a fresh OUTPUT directory")
endif()
find_program(GIT git REQUIRED)
function(checked)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Failed: ${ARGV}\n${output}\n${error}")
  endif()
endfunction()
execute_process(COMMAND "${GIT}" -C "${root}" status --porcelain OUTPUT_VARIABLE status RESULT_VARIABLE status_result)
if(NOT status_result EQUAL 0 OR NOT status STREQUAL "")
  message(FATAL_ERROR "Commit the reviewed source first; sharing uses committed files only")
endif()
execute_process(COMMAND "${GIT}" -C "${root}" rev-parse HEAD OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(MAKE_DIRECTORY "${OUTPUT}/OrbDuel-source")
set(source "${OUTPUT}/OrbDuel-source")
checked("${GIT}" -C "${root}" archive --format=tar "--output=${OUTPUT}/source.tar" HEAD)
file(ARCHIVE_EXTRACT INPUT "${OUTPUT}/source.tar" DESTINATION "${source}")
file(REMOVE "${OUTPUT}/source.tar" "${source}/mods/lava/lava.dll")
file(WRITE "${source}/PROVENANCE.md" "# Source handoff provenance\n\nThis source snapshot is derived from https://github.com/HHHHia/cpp at ${revision}. Original copyright, third-party licenses and source attribution are retained.\n\nThe original repository history is unchanged. This distribution initializes a fresh Git repository to avoid carrying old personal identifiers, machine settings or unrelated refs. Its initial commit records an import, not a claim of authorship. Continue development using each contributor's own Git identity.\n\nThe project was developed with coding-agent assistance. See docs/HANDOFF.md for existing work, implementation boundaries and tasks that team members can actually complete and present.\n\nmacOS adaptation is included as C++ source and build/install scripts. macOS compilation and device testing were explicitly not performed. See docs/MACOS.md and docs/VALIDATION.md.\n")
checked("${GIT}" -C "${source}" init -b main --template=)
checked("${GIT}" -C "${source}" config core.autocrlf false)
checked("${GIT}" -C "${source}" add --all)
file(GLOB_RECURSE scripts RELATIVE "${source}" "${source}/*.sh" "${source}/*.command")
foreach(script IN LISTS scripts)
  checked("${GIT}" -C "${source}" update-index --chmod=+x -- "${script}")
endforeach()
checked("${GIT}" -C "${source}" -c user.name=Source-import -c user.email=source-import@localhost -c commit.gpgsign=false -c core.hooksPath=.git/hooks commit -m "Import attributed OrbDuel source handoff")
checked("${GIT}" -C "${source}" fsck --no-reflogs)
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUTPUT}/OrbDuel-source.zip" --format=zip OrbDuel-source WORKING_DIRECTORY "${OUTPUT}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not create source ZIP")
endif()
message(STATUS "Share ${OUTPUT}/OrbDuel-source.zip; original repository history was not modified")
