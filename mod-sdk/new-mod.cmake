cmake_minimum_required(VERSION 3.20)
# 跨平台复制器：只生成 C++ 工程，不解释或执行玩法逻辑。
if(NOT DEFINED ID OR NOT ID MATCHES "^[a-z][a-z0-9_-]*$")
  message(FATAL_ERROR "Pass -DID=my-mod (lowercase letters, digits, - or _)")
endif()
if(NOT DEFINED KIND)
  set(KIND vortex)
endif()
if(NOT KIND MATCHES "^(vortex|summon|ability|rewind|guardian)$")
  message(FATAL_ERROR "KIND must be vortex, summon, ability, rewind or guardian")
endif()
if(NOT DEFINED NAME)
  set(NAME "${ID}")
endif()
if(NOT DEFINED DESTINATION)
  get_filename_component(DESTINATION "${CMAKE_CURRENT_LIST_DIR}/../user/mod-projects/${ID}" ABSOLUTE)
endif()
if(EXISTS "${DESTINATION}")
  message(FATAL_ERROR "Project already exists; choose another ID or DESTINATION")
endif()
file(MAKE_DIRECTORY "${DESTINATION}/include")
foreach(file CMakeLists.txt mod.json my_mod.cpp mod_config.hpp.in build-install.ps1 build-install.cmd build-install.sh Build-Install.command install-mod.cmake README.md .gitignore)
  file(COPY "${CMAKE_CURRENT_LIST_DIR}/template/${file}" DESTINATION "${DESTINATION}")
endforeach()
file(COPY "${CMAKE_CURRENT_LIST_DIR}/include/orbduel_mod.hpp" "${CMAKE_CURRENT_LIST_DIR}/include/orbduel_entities.hpp" "${CMAKE_CURRENT_LIST_DIR}/include/orbduel_abilities.hpp" DESTINATION "${DESTINATION}/include")
configure_file("${CMAKE_CURRENT_LIST_DIR}/LICENSE.txt" "${DESTINATION}/SDK_LICENSE.txt" COPYONLY)
file(READ "${DESTINATION}/mod.json" manifest)
foreach(pair id name typeName library)
  if(pair STREQUAL "id")
    set(value "${ID}")
  elseif(pair STREQUAL "library")
    set(value "${ID}.dll")
  else()
    set(value "${NAME}")
  endif()
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(JSON manifest SET "${manifest}" ${pair} "\"${value}\"")
endforeach()
if(KIND STREQUAL "summon")
  configure_file("${CMAKE_CURRENT_LIST_DIR}/examples/summon.cpp" "${DESTINATION}/my_mod.cpp" COPYONLY)
  string(JSON manifest SET "${manifest}" typeId "\"echo\"")
  string(JSON manifest SET "${manifest}" defaults "{\"interval\":2,\"maxAlive\":2,\"lifetime\":8,\"hpScale\":0.35,\"radiusScale\":0.65,\"attackScale\":0.5,\"speed\":280}")
endif()
if(KIND STREQUAL "ability")
  configure_file("${CMAKE_CURRENT_LIST_DIR}/examples/ability.cpp" "${DESTINATION}/my_mod.cpp" COPYONLY)
  string(JSON manifest SET "${manifest}" typeId "\"ability\"")
  string(JSON manifest SET "${manifest}" defaults "{\"cooldown\":8,\"shieldAmount\":8,\"shieldRadius\":140,\"shieldDuration\":1.5}")
endif()
if(KIND STREQUAL "rewind")
  configure_file("${CMAKE_CURRENT_LIST_DIR}/examples/rewind.cpp" "${DESTINATION}/my_mod.cpp" COPYONLY)
  string(JSON manifest SET "${manifest}" typeId "\"rewind\"")
  string(JSON manifest SET "${manifest}" defaults "{\"lookback\":3,\"cooldown\":8,\"threshold\":0.45}")
endif()
if(KIND STREQUAL "guardian")
  configure_file("${CMAKE_CURRENT_LIST_DIR}/examples/guardian.cpp" "${DESTINATION}/my_mod.cpp" COPYONLY)
  string(JSON manifest SET "${manifest}" typeId "\"guardian\"")
  string(JSON manifest SET "${manifest}" defaults "{\"respawn\":5,\"hpScale\":0.4,\"radiusScale\":0.6,\"attackScale\":0.5,\"speed\":220,\"followDistance\":60,\"interceptRadius\":180,\"shieldRadius\":140,\"shieldAmount\":8,\"shieldDuration\":1.5,\"shieldInterval\":3}")
endif()
file(WRITE "${DESTINATION}/mod.json" "${manifest}\n")
file(CHMOD "${DESTINATION}/build-install.sh" "${DESTINATION}/Build-Install.command" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
message(STATUS "Created ${DESTINATION}")
