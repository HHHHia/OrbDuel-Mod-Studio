cmake_minimum_required(VERSION 3.20)
# 仅安装生成清单指定的一个模组，不复制工程、缓存或本地设置。
set(package "${PACKAGE_DIR}")
if(NOT EXISTS "${package}/mod.json" OR NOT DEFINED DESTINATION)
message(FATAL_ERROR "Pass PACKAGE_DIR and DESTINATION for the newly built package")
endif()
file(READ "${package}/mod.json" manifest)
string(JSON id GET "${manifest}" id)
string(JSON library GET "${manifest}" library)
if(NOT id MATCHES "^[a-z][a-z0-9_-]*$" OR NOT library MATCHES "^[A-Za-z0-9_.-]+[.](dll|dylib)$")
  message(FATAL_ERROR "Invalid package filenames")
endif()
if(NOT EXISTS "${package}/${library}")
  message(FATAL_ERROR "Build output missing: ${library}")
endif()
file(MAKE_DIRECTORY "${DESTINATION}/${id}")
file(COPY "${package}/${library}" "${package}/mod.json" "${package}/SDK_LICENSE.txt" DESTINATION "${DESTINATION}/${id}")
if(IS_DIRECTORY "${package}/assets")
  file(COPY "${package}/assets" DESTINATION "${DESTINATION}/${id}")
endif()
