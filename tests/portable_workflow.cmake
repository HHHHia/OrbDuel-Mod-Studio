cmake_minimum_required(VERSION 3.20)
# 仅在 Windows 运行；检查跨平台生成器与安装器不破坏现有 C++ 模组流程。
string(TIMESTAMP stamp "%Y%m%d%H%M%S")
set(run "${SCRATCH}/${stamp}")
set(overlay "${run}/用户模组 [overlay]")
function(run_checked)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Command failed: ${ARGV}\n${output}\n${error}")
  endif()
endfunction()
foreach(kind vortex summon ability rewind guardian)
  if(kind STREQUAL "vortex")
    set(id gravity)
  elseif(kind STREQUAL "summon")
    set(id portable-summons)
  else()
    set(id "portable-${kind}")
  endif()
  set(project "${run}/工程 [${kind}]")
  run_checked("${CMAKE_COMMAND}" "-DID=${id}" "-DKIND=${kind}" "-DNAME=便携模板" "-DDESTINATION=${project}" -P "${SDK}/new-mod.cmake")
  file(READ "${project}/mod.json" manifest)
  if(kind STREQUAL "vortex")
    string(JSON manifest SET "${manifest}" defaults strength -777)
  elseif(kind STREQUAL "ability")
    string(JSON manifest SET "${manifest}" defaults shieldAmount 33)
  endif()
  file(WRITE "${project}/mod.json" "${manifest}\n")
  run_checked("${CMAKE_COMMAND}" -S "${project}" -B "${project}/build" -G "${GENERATOR}" -A x64)
  run_checked("${CMAKE_COMMAND}" --build "${project}/build" --config Release --parallel 2)
  file(READ "${project}/build/orbduel-package.txt" package)
  run_checked("${CMAKE_COMMAND}" "-DPACKAGE_DIR=${package}" "-DDESTINATION=${overlay}" -P "${project}/install-mod.cmake")
  if(NOT EXISTS "${project}/Build-Install.command" OR NOT EXISTS "${project}/include/orbduel_entities.hpp")
    message(FATAL_ERROR "Copied SDK is not self-contained")
  endif()
endforeach()
run_checked("${HOST}" "${CONTENT}" "${MODS}" "${overlay}")
message(STATUS "Portable C++ generator/install/override workflow passed on Windows")
