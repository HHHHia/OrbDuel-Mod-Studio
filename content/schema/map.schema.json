{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbduel.local/schema/map.schema.json",
  "title": "OrbDuel map",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "name", "size", "spawns"],
  "properties": {
    "format": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "name": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 32 },
        "zh": { "type": "string", "maxLength": 16 }
      }
    },
    "size": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "[width, height]"
    },
    "theme": {
      "type": "object",
      "properties": {
        "bgTexture": { "type": "string" },
        "bgColor": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 },
          "minItems": 4,
          "maxItems": 4
        },
        "wallColor": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 },
          "minItems": 4,
          "maxItems": 4
        },
        "wallThickness": { "type": "number", "minimum": 0, "maximum": 40 }
      }
    },
    "spawns": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["pos", "dir"],
        "properties": {
          "pos": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "dir": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "character": { "type": "string" }
        }
      }
    },
    "obstacles": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["shape", "pos"],
        "properties": {
          "shape": { "enum": ["rect", "circle"] },
          "pos": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "size": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "radius": { "type": "number", "minimum": 1 },
          "restitution": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "physics": {
      "type": "object",
      "properties": {
        "wallRestitution": { "type": "number", "minimum": 0, "maximum": 1 },
        "bounceJitterDeg": { "type": "number", "minimum": 0, "maximum": 5 },
        "maxSpeed": { "type": "number", "minimum": 100, "maximum": 5000 },
        "damageScale": { "type": "number", "minimum": 0, "maximum": 10 },
        "refSpeed": { "type": "number", "minimum": 1 }
      }
    },
    "shrink": {
      "type": "object",
      "properties": {
        "firstAt": { "type": "number", "minimum": 5, "maximum": 300 },
        "interval": { "type": "number", "minimum": 3, "maximum": 120 },
        "step": { "type": "number", "minimum": 0.01, "maximum": 0.2 },
        "minInset": { "type": "number", "minimum": 0, "maximum": 1.0 },
        "warnTime": { "type": "number", "minimum": 0, "maximum": 5 },
        "animTime": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "damagePerSec": { "type": "number", "minimum": 0, "maximum": 50 },
        "lullTrigger": { "type": "number", "minimum": 0, "maximum": 60 }
      }
    },
    "seed": { "type": "integer", "minimum": 0 }
  }
}
